// packages/mcp-server/wrangler.test.jsonc
//
// TEST-ONLY Wrangler config used by @cloudflare/vitest-pool-workers to resolve
// MCP_OBJECT (→ EngramMcp) and WORKSPACE (→ WorkspaceDO) bindings inside test
// runs. This file is NOT used by `wrangler dev` or `wrangler deploy` — those
// use packages/mcp-server/wrangler.jsonc.
//
// Why a separate file (not a shared `wrangler.jsonc`):
//   1. The FND-08 lint glob is `packages/*/wrangler.jsonc` (literal filename —
//      see scripts/lint-wrangler.mjs line 37). The `.test.jsonc` suffix means
//      this file is NOT linted, by design — it carries its own minimal
//      v1 + v2 migrations that exist ONLY for the test pool's binding
//      resolver.
//   2. The test pool needs BOTH DO bindings (MCP_OBJECT → EngramMcp + WORKSPACE
//      → WorkspaceDO) because the mcp-server Worker hosts both Durable Object
//      classes. The production wrangler.jsonc has the same two bindings; this
//      file mirrors that shape with its own minimal migrations.
//   3. `compatibility_date` is intentionally omitted — the test pool infers
//      the latest per the Cloudflare-maintained fixture pattern. Including a
//      date would freeze the test runtime to a specific version that may
//      drift from production.
//   4. KV namespaces (OAUTH_KV, ENGRAM_IDENTITIES) are NOT declared here.
//      Wave 0's oauth.test.ts is a structural RED stub (it.skip) that does
//      not actually exercise KV; Wave 2 may extend this file with KV mocks
//      or use `--unsafe.bindings` if its real implementation needs them.
//
// FND-08 invariant: this file uses `new_sqlite_classes` (NOT `new_classes`).
// Even though the lint glob doesn't pick this file up, the convention is
// permanent project policy — KV-backed DOs cannot be retroactively converted
// to SQLite-backed (Cloudflare workers-sdk #9909).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "engram-mcp-server-test",
  "main": "src/index.ts",
  // Phase 5 AI + VECTORIZE test bindings. Unit tests mock via vi.spyOn; integration
  // tests (AI-02 namespace isolation, AI-08 round-trip) opt into real Cloudflare
  // via remote: true in Plan 05-03/05-05 when real Vectorize is required. For Wave 0
  // the entry stays local so unit-test mocking via vi.spyOn(env.VECTORIZE, "query") works.
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "engram-memories", "remote": true }],
  "queues": {
    // ENG-20 AI-04: INGEST_QUEUE producer wired so the eval test's remember()
    // calls actually enqueue MemoryEvents for the deployed triage-worker to
    // consume → embed → upsert into Vectorize. Without this, remember()
    // silently skips the queue send (see tools.ts:438 log) and Vectorize
    // stays empty, making recall() return nothing.
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "engram-ingest" }],
  },
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "engram_ai_analytics" }],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "EngramMcp" },
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkspaceDO"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EngramMcp"],
    },
  ],
}
