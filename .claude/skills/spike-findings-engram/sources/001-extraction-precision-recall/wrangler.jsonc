{
  // Spike-only Worker. NOT a production package. Lives under .planning/spikes/
  // so npm workspaces never see it. wrangler dev calls REAL Workers AI —
  // user must `wrangler login` against Russell's Cloudflare account first.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engram-spike-001-extraction",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
  },
  "dev": {
    "port": 8901,
  },
}
